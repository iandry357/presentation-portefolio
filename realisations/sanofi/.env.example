# ─────────────────────────────────────────
# GCP
# ─────────────────────────────────────────
GCP_PROJECT_ID=
GCP_SA_KEY_PATH=gcp_sa_sanofi.json

BQ_DATASET_CLINICAL_TRIALS=sanofi_clinical_trials
BQ_DATASET_PUBMED=sanofi_pubmed
BQ_DATASET_NEWS=sanofi_news

# ─────────────────────────────────────────
# ChromaDB
# ─────────────────────────────────────────
CHROMA_HOST=portefolio-chromadb
CHROMA_PORT=8000
CHROMA_USER=portefolio
CHROMA_PASSWORD=

CHROMA_COLLECTION_CLINICAL_TRIALS=sanofi_clinical_trials
CHROMA_COLLECTION_PUBMED=sanofi_pubmed
CHROMA_COLLECTION_NEWS=sanofi_news

# ─────────────────────────────────────────
# VoyageAI
# ─────────────────────────────────────────
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_EMBEDDING_DIMENSIONS=1024

# ─────────────────────────────────────────
# LLM (fallback Gemini → Mistral → Groq)
# ─────────────────────────────────────────
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# ─────────────────────────────────────────
# Pipeline
# ─────────────────────────────────────────
PIPELINE_ENV=local