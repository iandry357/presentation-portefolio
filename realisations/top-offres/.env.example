# Secrets du worker Top Offres — copier en .env (jamais commité)
# PostgreSQL prod, utilisateur lecture seule (top-offres-reader)
PG_HOST=
PG_PORT=7312
PG_DB=rdb
PG_USER=top-offres-reader
PG_PASSWORD=

# Clé du compte de service pipeline-top-offres, montée dans le conteneur
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp_sa_top_offres.json

# Les autres paramètres (section 7 du cahier) ont des défauts dans pipeline/config.py
# et se surchargent ici si besoin : MODELE_SCORING, MODELE_CIBLES, SEUIL_HAUT, SEUIL_BAS, ...
